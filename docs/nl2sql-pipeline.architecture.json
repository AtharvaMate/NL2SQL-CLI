  "cards": [
    {
      "dot": "cyan",
      "title": "Parallel Fan-out (LangGraph)",
      "items": [
        "parallel_start fans out to cache_lookup + schema_analyzer simultaneously",
        "dispatch_or_skip fan-in waits for BOTH branches before routing",
        "Cache hit skips all 7 LLM agents — zero inference cost"
      ]
    },
    {
      "dot": "emerald",
      "title": "9 Specialist Agents",
      "items": [
        "cache_lookup — Redis GET by SHA-256 semantic hash",
        "schema_analyzer — Groq selects relevant tables from DDL",
        "finetuned_generator — Qwen2.5-1.5B NL2SQL (fast)",
        "syntax_validator — sqlglot + SELECT-only enforcement",
        "executor — SQL in Docker-sandboxed container",
        "superior_generator — OmniRoute with prior SQL + error",
        "judge — LLM-as-judge correctness scoring",
        "performance_optimizer — llama-3.3-70b SQL rewrite",
        "privacy_guard — PII redaction + audit log"
      ]
    },
    {
      "dot": "rose",
      "title": "Self-Correcting Retry Loop",
      "items": [
        "Step 1: finetuned model — fast path for common queries",
        "Steps 2-3: superior model with prior SQL + exact error",
        "Escalation: syntax invalid · exec error · judge rejected",
        "Exhausted → best attempt; Docker falls back to local SQLite"
      ]
    }
  ]
