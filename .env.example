# ── LLM Endpoints ─────────────────────────────────────────────────────────────
HF_ENDPOINT=https://atharvamate-qwen2-5-1-5b-nl2sql.hf.space
HF_TOKEN=hf_your_token_here
OMNIROUTE_URL=http://localhost:20128/v1/chat/completions
OMNIROUTE_GEN_MODEL=auto/coding:free
OMNIROUTE_JUDGE_MODEL=no-think/antigravity/claude-sonnet-4-6

# ── Engine tuning ─────────────────────────────────────────────────────────────
MAX_FINETUNED_STEPS=1
MAX_TOTAL_STEPS=3
DOCKER_IMAGE=python:3.12-slim

# ── Redis (queue + cache) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Langfuse observability (optional — leave blank to disable) ────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── DB + Schema (optional — set via TUI input boxes, auto-saved here) ─────────
# DB_PATH=
# SCHEMA_PATH=
